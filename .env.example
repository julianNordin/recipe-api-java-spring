# Copy to .env and adjust if you need to. .env is gitignored - never commit real credentials.
#
#   cp .env.example .env
#
# Every value here also has a default baked into docker-compose.yml and application.yml, so the
# project starts with no .env at all. The file exists so the knobs are discoverable.

POSTGRES_USER=recipes
POSTGRES_PASSWORD=recipes
POSTGRES_DB=recipes

# Host port the database is published on. Change it if 5432 is already taken locally.
POSTGRES_PORT=5432
